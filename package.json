{
  "name": "sl-dash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy:worker": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maplibre-gl-worker.mjs')\"",
    "predev": "npm run copy:worker",
    "prebuild": "npm run copy:worker",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "data:fetch": "python pipeline/fetch_cmems.py",
    "data:fetch:sat": "python pipeline/fetch_satellite.py",
    "data:build": "python pipeline/build_dashboard_data.py"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "maplibre-gl": "^6.13.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
